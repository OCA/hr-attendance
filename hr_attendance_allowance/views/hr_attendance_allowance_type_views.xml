<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_attendance_allowance_type_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.allowance.type.form</field>
        <field name="model">hr.attendance.allowance.type</field>
        <field name="arch" type="xml">
            <form string="Allowance Type">
                <sheet>
                    <group col="4">
                        <field name="name" />
                        <field name="code" />
                        <field name="active" />
                        <field name="company_id" groups="base.group_multi_company" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hr_attendance_allowance_type_view_tree" model="ir.ui.view">
        <field name="name">hr.attendance.allowance.type.tree</field>
        <field name="model">hr.attendance.allowance.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="code" />
                <field name="active" />
                <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>
    <record id="hr_attendance_allowance_type_action" model="ir.actions.act_window">
        <field name="name">Allowance Types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.attendance.allowance.type</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
        id="hr_attendance_allowance_type_menu"
        name="Allowance Types"
        parent="hr_attendance.menu_hr_attendance_settings"
        action="hr_attendance_allowance_type_action"
        sequence="120"
        groups="hr_attendance.group_hr_attendance_manager"
    />
</odoo>
