<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="fmel_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.attendance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='auto_check_out']/.." position="attributes">
                <attribute name="help">
                    Automatically Check-Out Employees based on their working schedule with an additional tolerance.
                </attribute>
            </xpath>
            <xpath expr="//setting[@string='Automatic Check-Out']" position="after">
                <setting>
                    <label
                        string="Autoclose Reason"
                        for="hr_attendance_autoclose_reason"
                    />
                    <span
                        class="fa fa-lg fa-building-o"
                        title="Values set here are company-specific."
                        groups="base.group_multi_company"
                    />
                    <div class="row">
                        <div class="text-muted col-lg-8">
                            This reason will be added to an attendance
                            when it's autoclosed.
                        </div>
                    </div>
                    <div class="content-group mt16">
                        <field
                            name="hr_attendance_autoclose_reason"
                            can_create="true"
                            can_write="true"
                        />
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
