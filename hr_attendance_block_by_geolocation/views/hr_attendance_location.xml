<odoo>
    <record id="view_hr_attendance_location_tree" model="ir.ui.view">
        <field name="name">hr.attendance.location.tree</field>
        <field name="model">hr.attendance.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="latitude" />
                <field name="longitude" />
                <field name="radius_m" />
                <field name="map_url" readonly="1" widget="url" string="Open map" />
            </list>
        </field>
    </record>

    <record id="view_hr_attendance_location_form" model="ir.ui.view">
        <field name="name">hr.attendance.location.form</field>
        <field name="model">hr.attendance.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                    <group>
                        <field name="latitude" />
                        <field name="longitude" />
                        <field name="radius_m" />
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note" />
                        </page>
                    </notebook>
                    <group>
                        <field
                            name="map_url"
                            readonly="1"
                            widget="url"
                            string="Open map"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_attendance_location" model="ir.actions.act_window">
        <field name="name">Authorized Locations</field>
        <field name="res_model">hr.attendance.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_hr_attendance_location_root"
        name="Authorized Locations"
        parent="hr_attendance.menu_hr_attendance_root"
        action="action_hr_attendance_location"
        sequence="50"
    />
</odoo>
