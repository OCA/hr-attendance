<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_attendance_break_type_view_tree" model="ir.ui.view">
        <field name="name">hr.attendance.break.type.list</field>
        <field name="model">hr.attendance.break.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="paid" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="hr_attendance_break_type_action" model="ir.actions.act_window">
        <field name="name">Break Types</field>
        <field name="res_model">hr.attendance.break.type</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="menu_hr_attendance_break_type"
        name="Break Types"
        parent="hr_attendance.menu_hr_attendance_configuration"
        action="hr_attendance_break_type_action"
        sequence="60"
        groups="hr_attendance.group_hr_attendance_manager"
    />
</odoo>
