<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_attendance_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.form.break</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form" />
        <field name="priority">500</field>
        <field name="arch" type="xml">
            <sheet position="inside">
                <group name="break">
                    <group>
                        <field name="break_hours" widget="float_time" />
                        <field name="net_worked_hours" widget="float_time" />
                    </group>
                    <field name="break_ids">
                        <list editable="bottom">
                            <field name="break_type" />
                            <field name="break_start" />
                            <field name="break_stop" />
                            <field name="duration" widget="float_time" readonly="1" />
                        </list>
                    </field>
                </group>
            </sheet>
        </field>
    </record>

    <record id="hr_attendance_view_tree" model="ir.ui.view">
        <field name="name">hr.attendance.list.break</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree" />
        <field name="priority">500</field>
        <field name="arch" type="xml">
            <field name="worked_hours" position="after">
                <field name="break_hours" widget="float_time" optional="show" />
                <field name="net_worked_hours" widget="float_time" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
