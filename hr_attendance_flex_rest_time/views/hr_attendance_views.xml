<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_attendance_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.form.rest.time</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="is_calendar_flexible" invisible="1" />
                <field name="is_rest_time_editable" invisible="1" />
                <field
                    name="rest_time"
                    widget="float_time"
                    readonly="not is_rest_time_editable"
                    invisible="not is_calendar_flexible"
                />
            </xpath>
        </field>
    </record>
    <record id="hr_attendance_view_tree" model="ir.ui.view">
        <field name="name">hr.attendance.tree.rest.time</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field
                    name="rest_time"
                    string="Rest Time"
                    widget="float_time"
                    optional="hide"
                    sum="Total Rest Time"
                />
            </xpath>
        </field>
    </record>
</odoo>
