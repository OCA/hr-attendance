<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="idsecure_device_tree" model="ir.ui.view">
        <field name="name">idsecure.device.tree</field>
        <field name="model">idsecure.device</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="base_url" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'connected'"
                    decoration-danger="state == 'error'"
                    decoration-muted="state == 'draft'"
                />
                <field name="last_sync" />
                <field name="today_events" />
                <field name="failed_events" decoration-danger="failed_events > 0" />
            </tree>
        </field>
    </record>

    <record id="idsecure_device_form" model="ir.ui.view">
        <field name="name">idsecure.device.form</field>
        <field name="model">idsecure.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_test_connection"
                        string="Test Connection"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '=', 'connected')]}"
                    />
                    <button
                        name="action_test_connection"
                        string="Reconnect"
                        type="object"
                        attrs="{'invisible': [('state', '!=', 'error')]}"
                    />
                    <button
                        name="action_sync_access_events"
                        string="Sync Now"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'connected')]}"
                    />
                    <button
                        name="%(hr_attendance_idsecure.action_idsecure_historical_sync_wizard)d"
                        string="Recover Events"
                        type="action"
                        attrs="{'invisible': [('state', '!=', 'connected')]}"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,connected"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            type="action"
                            name="%(hr_attendance_idsecure.action_idsecure_access_log)d"
                            icon="fa-list"
                            context="{'search_default_device_id': active_id}"
                        >
                            <field
                                name="total_events"
                                widget="statinfo"
                                string="Events"
                            />
                        </button>
                        <button
                            class="oe_stat_button"
                            type="action"
                            name="%(hr_attendance_idsecure.action_idsecure_access_log)d"
                            icon="fa-exclamation-triangle"
                            context="{'search_default_device_id': active_id, 'search_default_errors': 1}"
                            attrs="{'invisible': [('failed_events', '=', 0)]}"
                        >
                            <field
                                name="failed_events"
                                widget="statinfo"
                                string="Errors"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Portaria MCP" /></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field
                                name="base_url"
                                placeholder="https://access-control.example.com"
                            />
                            <field name="username" />
                            <field name="password" password="True" />
                            <field name="timeout" />
                        </group>
                        <group string="Sync Settings">
                            <field name="poll_interval" />
                            <field name="tz" />
                            <field name="hours_to_check" />
                            <field name="last_sync" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <group
                        string="Last Error"
                        attrs="{'invisible': [('last_error', '=', False)]}"
                    >
                        <field name="last_error" nolabel="1" readonly="1" />
                    </group>
                    <notebook>
                        <page string="Company Mappings" name="mappings">
                            <div class="oe_inline">
                                <button
                                    name="action_load_mappings"
                                    string="Load from ControliD"
                                    type="object"
                                    class="oe_highlight mb-3"
                                    attrs="{'invisible': [('state', '!=', 'connected')]}"
                                />
                            </div>
                            <p class="text-muted">
                                Configure which ControliD companies/groups get imported.
                                Uncheck "Import Attendance" to skip visitors and suppliers.
                            </p>
                            <field
                                name="mapping_ids"
                                nolabel="1"
                                context="{'default_device_id': active_id}"
                            >
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="idsecure_group_id" />
                                    <field name="idsecure_id_type" />
                                    <field name="company_id" />
                                    <field name="employee_type" />
                                    <field name="import_attendance" />
                                    <field name="device_id" invisible="1" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_idsecure_device" model="ir.actions.act_window">
        <field name="name">iDSecure Devices</field>
        <field name="res_model">idsecure.device</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first iDSecure access control server
            </p>
        </field>
    </record>

</odoo>
