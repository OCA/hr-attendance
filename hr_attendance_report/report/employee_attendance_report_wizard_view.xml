<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_one_set">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="employees_data" t-as="employee">
                    <div class="page">
                        <div class="oe_structure" id="oe_structure_attendance_report">
                            <h1 class="text-center">Attendance Report</h1>
                        </div>

                        <!-- Report Header -->
                        <table class="table text-center table-sm table-striped mt-4">
                            <tr>
                                <td><strong>Month</strong></td>
                                <td><t t-esc="month_name" /></td>
                                <td><strong>Year</strong></td>
                                <td><t t-esc="year" /></td>
                            </tr>
                        </table>

                        <!-- Employee Information -->
                        <table class="table text-center table-bordered mt-4">
                            <thead>
                                <tr>
                                    <th>Employee Name</th>
                                    <th>Manager</th>
                                    <th>Department</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><t t-esc="employee['emp_name']" /></td>
                                    <td><t t-esc="employee['manager']" /></td>
                                    <td><t t-esc="employee['department']" /></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Summary Statistics -->
                        <table class="table text-center table-sm mt-4">
                            <tr>
                                <td><strong>Total Days Worked:</strong></td>
                                <td><t t-esc="employee['total_days']" /></td>
                                <td><strong>Total Hours:</strong></td>
                                <td><t t-esc="employee['total_hours']" /> hours</td>
                                <td><strong>Average Hours/Day:</strong></td>
                                <td><t
                                        t-esc="employee['avg_hours_per_day']"
                                    /> hours</td>
                            </tr>
                        </table>

                        <!-- Attendance Records -->
                        <table class="table text-center table-bordered mt-4">
                            <thead>
                                <tr>
                                    <th>Check In</th>
                                    <th>Check Out</th>
                                    <th>Working Hours</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="employee['attendances']">
                                    <!-- Attendance records -->
                                    <t
                                        t-foreach="employee['attendances']"
                                        t-as="attendance"
                                    >
                                        <tr>
                                            <td>
                                                <t t-if="attendance['check_in']">
                                                    <span
                                                        t-esc="attendance['check_in']"
                                                        t-options="{'widget': 'datetime'}"
                                                    />
                                                </t>
                                                <t t-else="">N/A</t>
                                            </td>
                                            <td>
                                                <t t-if="attendance['check_out']">
                                                    <span
                                                        t-esc="attendance['check_out']"
                                                        t-options="{'widget': 'datetime'}"
                                                    />
                                                </t>
                                                <t t-else="">Still Working</t>
                                            </td>
                                            <td>
                                                <span
                                                    t-esc="attendance['worked_hours']"
                                                /> hrs
                                            </td>
                                        </tr>
                                    </t>
                                    <!-- Total row after last attendance record -->
                                    <tr class="table-info">
                                        <td colspan="2"><strong>Total:</strong></td>
                                        <td>
                                            <strong><t
                                                    t-esc="employee['total_hours']"
                                                /> hrs</strong>
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="3" class="text-muted">
                                            No attendance records found for this period
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Page break for multiple employees -->
                        <div style="page-break-after: always;" />
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
