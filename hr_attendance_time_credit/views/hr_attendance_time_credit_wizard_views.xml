<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_attendance_time_credit_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.time.credit.report.wizard.form</field>
        <field name="model">hr.attendance.time.credit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Time Credit Monthly Report">
                <group>
                    <group string="Period">
                        <field name="date_from" />
                        <field name="date_to" />
                    </group>
                    <group string="Employees">
                        <field
                            name="employee_ids"
                            widget="many2many_tags"
                            nolabel="1"
                        />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_print_report"
                        type="object"
                        string="Print Report"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_attendance_time_credit_wizard_action" model="ir.actions.act_window">
        <field name="name">Print Monthly Report</field>
        <field name="res_model">hr.attendance.time.credit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="hr_attendance_time_credit_wizard_menu"
        name="Print Monthly Report"
        parent="hr_attendance.menu_hr_attendance_reporting"
        action="hr_attendance_time_credit_wizard_action"
        sequence="20"
        groups="hr_attendance.group_hr_attendance_manager"
    />
</odoo>
