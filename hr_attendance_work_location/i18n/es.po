#: model_terms:ir.ui.view,arch_db:hr_attendance_work_location.res_config_settings_view_form
msgid "GPS Tolerance (meters)"
msgstr "Tolerancia GPS (metros)"

#. module: hr_attendance_work_location
#: model:ir.model.constraint,message:hr_attendance_work_location.constraint_res_company_geo_tolerance_meters_non_negative
msgid "GPS tolerance must be non-negative."
msgstr "La tolerancia GPS debe ser no negativa."

#. module: hr_attendance_work_location
#: model_terms:ir.ui.view,arch_db:hr_attendance_work_location.res_config_settings_view_form
msgid ""
"Proximity tolerance in meters for\n"
"                                auto-assigning work locations at check-in/"
"out.\n"
"                                Default is 111 meters. Set to 0 to disable."
msgstr ""
"Tolerancia de proximidad en metros para\n"
"                                asignación automática de ubicaciones de "
"trabajo en entrada/salida.\n"
"                                El valor predeterminado es 111 metros. "
"Establecer en 0 para deshabilitar."

#. module: hr_attendance_work_location
#: model:ir.model.fields,help:hr_attendance_work_location.field_res_company__geo_tolerance_meters
#: model:ir.model.fields,help:hr_attendance_work_location.field_res_config_settings__geo_tolerance_meters
msgid ""
"Proximity tolerance in meters for auto-assigning work locations at check-in/"
"check-out. Default is 111 meters. Set to 0 to disable automatic matching."
msgstr ""
"Tolerancia de proximidad en metros para la asignación automática de "
"ubicaciones de trabajo en entrada/salida. El valor predeterminado es 111 "
"metros. Establecer en 0 para deshabilitar la coincidencia automática."

#. module: hr_attendance_work_location
#: model_terms:ir.ui.view,arch_db:hr_attendance_work_location.res_config_settings_view_form
msgid "Values set here are company-specific."
msgstr "Los valores aquí establecidos son específicos de la compañía."

#. module: hr_attendance_work_location
#: model:ir.model.fields,help:hr_attendance_work_location.field_hr_work_location__exclude_from_attendance
msgid ""
"When set, this work location will be ignored for automatic assignment to "
"attendances based on GPS coordinates."
msgstr ""
"Si está marcado, esta ubicación de trabajo se ignorará en la asignación "
"automática de asistencias basada en coordenadas GPS."

