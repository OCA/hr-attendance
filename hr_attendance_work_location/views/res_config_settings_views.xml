<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_attendance']" position="inside">
                <block
                    title="Work Location Tracking"
                    name="work_location_tracking_settings_container"
                >
                    <setting>
                        <label
                            string="GPS Tolerance (meters)"
                            for="geo_tolerance_meters"
                        />
                        <span
                            class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            groups="base.group_multi_company"
                        />
                        <div class="content-group mt16">
                            <field name="geo_tolerance_meters" />
                            <div class="text-muted mt8">
                                Proximity tolerance in meters for
                                auto-assigning work locations at check-in/out.
                                Default is 111 meters. Set to 0 to disable.
                            </div>
                        </div>
                    </setting>
                    <setting>
                        <label string="Work Location Mode" for="work_location_mode" />
                        <span
                            class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            groups="base.group_multi_company"
                        />
                        <div class="content-group mt16">
                            <field name="work_location_mode" />
                            <div class="text-muted mt8">
                                Work location is resolved automatically from GPS coordinates
                                or employee selects work location from a dropdown,
                                depending on the mode above.
                            </div>
                        </div>
                    </setting>
                    <setting>
                        <label
                            string="Default Work Location"
                            for="manual_work_location_id"
                        />
                        <div class="content-group mt16">
                            <field
                                name="manual_work_location_id"
                                domain="[('company_id', '=', company_id), ('exclude_from_attendance', '=', False)]"
                            />
                        </div>
                    </setting>
                    <setting>
                        <field name="work_location_required" />
                        <label
                            string="Require Work Location Selection"
                            for="work_location_required"
                        />
                        <div class="text-muted mt8">
                            When enabled, the employee must select a work location before checking in.
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
